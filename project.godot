; Engine configuration file.
; 星速（Star Speed）demo —— 规格第 11.1、11.5 节

config_version=5

[application]

config/name="Star Speed"
config/icon="res://icon.png"
boot_splash/bg_color=Color(0.106, 0.133, 0.2, 1)
boot_splash/image="res://icon.png"
boot_splash/fullsize=false
boot_splash/use_filter=true
config/windows_native_icon="res://icon.ico"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")

[audio]

buses/default_bus_layout="res://default_bus_layout.tres"

[autoload]

Tuning="*res://scripts/tuning.gd"
SaveData="*res://scripts/save_data.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/vsync/vsync_mode=1

